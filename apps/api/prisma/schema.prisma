generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  COMPANY_ADMIN
  ADDITIONAL
}

model Company {
  id           String         @id @default(uuid()) @db.Uuid
  ruc          String         @unique @db.VarChar(13)
  legalName    String
  tradeName    String?
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  users        User[]
  periods      AnnualPeriod[]
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String?   @db.Uuid
  company      Company?  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  username     String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole
  active       Boolean   @default(true)
  authVersion  Int       @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]

  @@unique([companyId, id])
  @@index([companyId, active])
}

model Session {
  id          String   @id @default(uuid()) @db.Uuid
  tokenHash   String   @unique @db.Char(64)
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  authVersion Int
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AnnualPeriod {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  startsAt      DateTime @db.Date
  endsAt        DateTime @db.Date
  documentLimit Int      @default(15)
  userLimit     Int      @default(3)
  createdAt     DateTime @default(now())

  @@unique([companyId, startsAt])
  @@unique([companyId, id])
  @@index([companyId, endsAt])
}
