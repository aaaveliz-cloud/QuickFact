NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Rol runtime limitado de PostgreSQL de desarrollo en Render. Sin valor real en Git.
DATABASE_URL=
# Sólo para herramientas administrativas/migraciones; no usar como rol runtime.
MIGRATION_DATABASE_URL=
# Ajustar según proxies verificados del servicio; nunca confiar en todos los proxies.
TRUST_PROXY_HOPS=0
